rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Delegates collection
    match /delegates/{id} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.uniqueCode is string;
      allow read: if true;
      allow update, delete: if true;
    }

    // 2. Tickets collection
    match /tickets/{id} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.uniqueCode is string;
      allow read: if true;
      allow update, delete: if true;
    }

    // 3. Troupes collection
    match /troupes/{id} {
      allow create: if request.resource.data.troupeName is string 
                    && request.resource.data.email is string
                    && request.resource.data.uniqueCode is string;
      allow read: if true;
      allow update, delete: if true;
    }

    // 4. Secretariat applications collection
    match /secretariat/{id} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.uniqueCode is string;
      allow read: if true;
      allow update, delete: if true;
    }

    // 5. Sponsors collection
    match /sponsors/{id} {
      allow create: if request.resource.data.brandName is string 
                    && request.resource.data.email is string
                    && request.resource.data.uniqueCode is string;
      allow read: if true;
      allow update, delete: if true;
    }

    // 6. Inquiries collection
    match /inquiries/{id} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string;
      allow read: if true;
      allow update, delete: if true;
    }

    // 7. Master Registrations collection
    match /registrations/{registrationId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.uniqueCode is string;
      allow read: if true;
      allow update, delete: if true;
    }

    // Event settings and metadata
    match /event_settings/{document=**} {
      allow read, write: if true;
    }

    // Health / connection test document as required by Firebase skill
    match /test/{document=**} {
      allow read, write: if true;
    }
  }
}
