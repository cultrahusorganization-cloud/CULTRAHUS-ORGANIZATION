{
  "entities": {
    "Delegate": {
      "title": "Delegate",
      "description": "Accredited delegate registrations for Cultrahus Sangam",
      "type": "object",
      "properties": {
        "uniqueCode": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "organization": { "type": "string" },
        "cityState": { "type": "string" },
        "participationCategory": { "type": "string" },
        "parliamentTrack": { "type": "string" },
        "priorExperience": { "type": "string" },
        "amountPaid": { "type": "number" },
        "status": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uniqueCode", "name", "email", "status", "createdAt"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Auditorium entry pass bookings for Cultrahus Sangam",
      "type": "object",
      "properties": {
        "uniqueCode": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "ticketTier": { "type": "string" },
        "tierName": { "type": "string" },
        "quantity": { "type": "number" },
        "amountPaid": { "type": "number" },
        "status": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uniqueCode", "name", "email", "ticketTier", "quantity", "status", "createdAt"]
    },
    "Troupe": {
      "title": "Troupe",
      "description": "Theatre & street play troupe entries",
      "type": "object",
      "properties": {
        "uniqueCode": { "type": "string" },
        "troupeName": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "organization": { "type": "string" },
        "playTitle": { "type": "string" },
        "playwright": { "type": "string" },
        "director": { "type": "string" },
        "castCrewCount": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "synopsis": { "type": "string" },
        "technicalRider": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uniqueCode", "troupeName", "name", "email", "playTitle", "status", "createdAt"]
    },
    "Secretariat": {
      "title": "Secretariat",
      "description": "Central organizing committee applicants",
      "type": "object",
      "properties": {
        "uniqueCode": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "organization": { "type": "string" },
        "department": { "type": "string" },
        "whyJoin": { "type": "string" },
        "timeCommitment": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uniqueCode", "name", "email", "department", "status", "createdAt"]
    },
    "Sponsor": {
      "title": "Sponsor",
      "description": "Corporate & brand patronage intents",
      "type": "object",
      "properties": {
        "uniqueCode": { "type": "string" },
        "brandName": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "cityState": { "type": "string" },
        "sponsorTier": { "type": "string" },
        "proposalNotes": { "type": "string" },
        "amountPaid": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uniqueCode", "brandName", "name", "email", "sponsorTier", "status", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "General helpdesk inquiries and contact submissions",
      "type": "object",
      "properties": {
        "uniqueCode": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "inquiryCategory": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uniqueCode", "name", "email", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/delegates/{delegateId}": {
      "schema": "Delegate",
      "description": "Distinct collection for accredited delegates"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Distinct collection for auditorium ticket bookings"
    },
    "/troupes/{troupeId}": {
      "schema": "Troupe",
      "description": "Distinct collection for theatre & street play troupes"
    },
    "/secretariat/{secretariatId}": {
      "schema": "Secretariat",
      "description": "Distinct collection for secretariat applications"
    },
    "/sponsors/{sponsorId}": {
      "schema": "Sponsor",
      "description": "Distinct collection for corporate sponsors"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Distinct collection for general contact inquiries"
    },
    "/registrations/{registrationId}": {
      "schema": "Delegate",
      "description": "Master index and backward-compatibility registry"
    },
    "/event_settings/{settingId}": {
      "schema": "EventSettings",
      "description": "Cultrahus organization and event configuration"
    }
  }
}
